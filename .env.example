# Variables de Entorno del Club de Baloncesto
# Renombra este archivo a .env para desarrollo local

# Supabase (Configuración > Project Settings > API)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-anon-public-key"

# Google Gemini API (Obtén tu clave gratis en https://aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."

# Seguridad y Acceso Web (Modifica tus credenciales)
SECRET_KEY="clave-secreta-aleatoria-para-sesiones"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia_esta_contraseña_segura"
